{
  "name": "dsh-cross-memory",
  "version": "0.2.0",
  "description": "@a9i5k4/dsh-auto-memory 的增量插件：①把跨实例硬约束（cross/RULES.md）全文注入每一轮上下文，改一处即全部实例生效；②提供结构化写入工具 cross_memory_write_entry（自动锚点行、≤200 字符索引行校验、超长正文外移、写前留基线）。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "dsh-auto-memory",
    "addon",
    "memory",
    "cross-instance",
    "rules"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShukebtAb/Dsh-Cross-Memory.git"
  },
  "homepage": "https://github.com/ShukebtAb/Dsh-Cross-Memory#readme",
  "bugs": {
    "url": "https://github.com/ShukebtAb/Dsh-Cross-Memory/issues"
  },
  "files": [
    "index.js",
    "entry-format.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "MIT"

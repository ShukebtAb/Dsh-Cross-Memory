{
  "name": "dsh-cross-memory",
  "version": "0.1.0",
  "description": "Add-on for @a9i5k4/dsh-auto-memory: inject cross-instance hard constraints (cross/RULES.md) into every turn — one rule source, all instances.",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "dsh-auto-memory",
    "addon",
    "memory",
    "cross-instance",
    "rules"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShukebtAb/Dsh-Cross-Memory.git"
  },
  "homepage": "https://github.com/ShukebtAb/Dsh-Cross-Memory#readme",
  "bugs": {
    "url": "https://github.com/ShukebtAb/Dsh-Cross-Memory/issues"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "MIT"
}
